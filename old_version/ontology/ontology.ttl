@prefix ra: <http://www.w3.org/2012/7/ra3.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dbpedia: <http://dbpedia.org/resource/> .
@base <http://www.w3.org/2002/07/owl#> .

[ rdf:type owl:Ontology
 ] .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2012/7/ra3.owl#codeINSEE
ra:codeINSEE rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.w3.org/2012/7/ra3.owl#driverOf
ra:driverOf rdf:type owl:ObjectProperty .


###  http://www.w3.org/2012/7/ra3.owl#hasLocation
ra:hasLocation rdf:type owl:ObjectProperty .


###  http://www.w3.org/2012/7/ra3.owl#inCommune
ra:inCommune rdf:type owl:ObjectProperty .


###  http://www.w3.org/2012/7/ra3.owl#inDepartment
ra:inDepartment rdf:type owl:ObjectProperty .


###  http://www.w3.org/2012/7/ra3.owl#involvedIn
ra:involvedIn rdf:type owl:ObjectProperty .


###  http://www.w3.org/2012/7/ra3.owl#occupantOf
ra:occupantOf rdf:type owl:ObjectProperty .


###  http://www.w3.org/2012/7/ra3.owl#vehicleInvolvedIn
ra:vehicleInvolvedIn rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://www.w3.org/2012/7/ra3.owl#NumAcc
ra:NumAcc rdf:type owl:DatatypeProperty ;
          rdfs:range xsd:string .


###  http://www.w3.org/2012/7/ra3.owl#adr
ra:adr rdf:type owl:DatatypeProperty ;
       rdfs:range xsd:string .


###  http://www.w3.org/2012/7/ra3.owl#agg
ra:agg rdf:type owl:DatatypeProperty ;
       rdfs:range xsd:int .


###  http://www.w3.org/2012/7/ra3.owl#an
ra:an rdf:type owl:DatatypeProperty ;
      rdfs:range xsd:int .


###  http://www.w3.org/2012/7/ra3.owl#anNais
ra:anNais rdf:type owl:DatatypeProperty ;
          rdfs:range xsd:int .


###  http://www.w3.org/2012/7/ra3.owl#catu
ra:catu rdf:type owl:DatatypeProperty ;
        rdfs:range xsd:int .


###  http://www.w3.org/2012/7/ra3.owl#catv
ra:catv rdf:type owl:DatatypeProperty ;
        rdfs:range xsd:int .


###  http://www.w3.org/2012/7/ra3.owl#com
ra:com rdf:type owl:DatatypeProperty ;
       rdfs:range xsd:int .


###  http://www.w3.org/2012/7/ra3.owl#dep
ra:dep rdf:type owl:DatatypeProperty ;
       rdfs:range xsd:int .


###  http://www.w3.org/2012/7/ra3.owl#grav
ra:grav rdf:type owl:DatatypeProperty ;
        rdfs:range xsd:int .


###  http://www.w3.org/2012/7/ra3.owl#hrmn
ra:hrmn rdf:type owl:DatatypeProperty ;
        rdfs:range xsd:string .


###  http://www.w3.org/2012/7/ra3.owl#jour
ra:jour rdf:type owl:DatatypeProperty ;
        rdfs:range xsd:int .


###  http://www.w3.org/2012/7/ra3.owl#lat
ra:lat rdf:type owl:DatatypeProperty ;
       rdfs:range xsd:string .


###  http://www.w3.org/2012/7/ra3.owl#long
ra:long rdf:type owl:DatatypeProperty ;
        rdfs:range xsd:string .


###  http://www.w3.org/2012/7/ra3.owl#lum
ra:lum rdf:type owl:DatatypeProperty ;
       rdfs:range xsd:int .


###  http://www.w3.org/2012/7/ra3.owl#mois
ra:mois rdf:type owl:DatatypeProperty ;
        rdfs:range xsd:int .


###  http://www.w3.org/2012/7/ra3.owl#numVeh
ra:numVeh rdf:type owl:DatatypeProperty ;
          rdfs:range xsd:string .


###  http://www.w3.org/2012/7/ra3.owl#numVehPers
ra:numVehPers rdf:type owl:DatatypeProperty ;
              rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  http://www.w3.org/2012/7/ra3.owl#Commune
ra:Commune rdf:type owl:Class ;
           rdfs:subClassOf ra:Location .


###  http://www.w3.org/2012/7/ra3.owl#Department
ra:Department rdf:type owl:Class ;
              rdfs:subClassOf ra:Location .


###  http://www.w3.org/2012/7/ra3.owl#Location
ra:Location rdf:type owl:Class .


###  http://www.w3.org/2012/7/ra3.owl#Man
ra:Man rdf:type owl:Class ;
       rdfs:subClassOf ra:Person ;
       owl:disjointWith ra:Woman .


###  http://www.w3.org/2012/7/ra3.owl#Person
ra:Person rdf:type owl:Class .


###  http://www.w3.org/2012/7/ra3.owl#RoadAccident
ra:RoadAccident rdf:type owl:Class .


###  http://www.w3.org/2012/7/ra3.owl#Vehicle
ra:Vehicle rdf:type owl:Class .


###  http://www.w3.org/2012/7/ra3.owl#Woman
ra:Woman rdf:type owl:Class ;
         rdfs:subClassOf ra:Person .

