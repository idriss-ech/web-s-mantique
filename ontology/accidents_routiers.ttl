@prefix : <http://www.semanticweb.org/ontologies/accidents-routiers#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix dbr: <http://dbpedia.org/resource/> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@base <http://www.semanticweb.org/ontologies/accidents-routiers#> .

<http://www.semanticweb.org/ontologies/accidents-routiers> rdf:type owl:Ontology ;
    rdfs:label "Ontologie des Accidents Routiers en France"@fr ;
    rdfs:comment "Ontologie pour modéliser les données d'accidents de la route en France (2024)"@fr .

#################################################################
#    Classes Principales
#################################################################

###  Accident
:Accident rdf:type owl:Class ;
    rdfs:label "Accident"@fr ;
    rdfs:comment "Événement d'accident de la route"@fr .

###  Lieu
:Lieu rdf:type owl:Class ;
    rdfs:label "Lieu"@fr ;
    rdfs:comment "Localisation géographique et caractéristiques du lieu de l'accident"@fr .

###  Usager
:Usager rdf:type owl:Class ;
    rdfs:label "Usager"@fr ;
    rdfs:comment "Personne impliquée dans un accident (conducteur ou passager)"@fr ;
    rdfs:subClassOf foaf:Person .

###  Vehicule
:Vehicule rdf:type owl:Class ;
    rdfs:label "Véhicule"@fr ;
    rdfs:comment "Véhicule impliqué dans un accident"@fr .

###  Departement
:Departement rdf:type owl:Class ;
    rdfs:label "Département"@fr ;
    rdfs:comment "Département français"@fr ;
    rdfs:subClassOf dbo:AdministrativeRegion .

###  Commune
:Commune rdf:type owl:Class ;
    rdfs:label "Commune"@fr ;
    rdfs:comment "Commune française"@fr ;
    rdfs:subClassOf dbo:AdministrativeRegion .

#################################################################
#    Classes pour les caractéristiques
#################################################################

###  ConditionLuminosite
:ConditionLuminosite rdf:type owl:Class ;
    rdfs:label "Condition de Luminosité"@fr .

###  ConditionAtmospherique
:ConditionAtmospherique rdf:type owl:Class ;
    rdfs:label "Condition Atmosphérique"@fr .

###  TypeCollision
:TypeCollision rdf:type owl:Class ;
    rdfs:label "Type de Collision"@fr .

###  TypeIntersection
:TypeIntersection rdf:type owl:Class ;
    rdfs:label "Type d'Intersection"@fr .

###  CategorieRoute
:CategorieRoute rdf:type owl:Class ;
    rdfs:label "Catégorie de Route"@fr .

###  TypeCirculation
:TypeCirculation rdf:type owl:Class ;
    rdfs:label "Type de Circulation"@fr .

###  Infrastructure
:Infrastructure rdf:type owl:Class ;
    rdfs:label "Infrastructure"@fr .

###  EtatSurface
:EtatSurface rdf:type owl:Class ;
    rdfs:label "État de la Surface"@fr .

###  CategorieVehicule
:CategorieVehicule rdf:type owl:Class ;
    rdfs:label "Catégorie de Véhicule"@fr .

###  Gravite
:Gravite rdf:type owl:Class ;
    rdfs:label "Gravité"@fr ;
    rdfs:comment "Niveau de gravité des blessures d'un usager"@fr .

###  CategorieUsager
:CategorieUsager rdf:type owl:Class ;
    rdfs:label "Catégorie d'Usager"@fr ;
    rdfs:comment "Conducteur ou passager"@fr .

###  TypeTrajet
:TypeTrajet rdf:type owl:Class ;
    rdfs:label "Type de Trajet"@fr .

#################################################################
#    Object Properties - Relations entre entités
#################################################################

###  aLieu
:aLieu rdf:type owl:ObjectProperty ;
    rdfs:domain :Accident ;
    rdfs:range :Lieu ;
    rdfs:label "a lieu"@fr .

###  implique_vehicule
:implique_vehicule rdf:type owl:ObjectProperty ;
    rdfs:domain :Accident ;
    rdfs:range :Vehicule ;
    rdfs:label "implique véhicule"@fr .

###  implique_usager
:implique_usager rdf:type owl:ObjectProperty ;
    rdfs:domain :Accident ;
    rdfs:range :Usager ;
    rdfs:label "implique usager"@fr .

###  dansDepartement
:dansDepartement rdf:type owl:ObjectProperty ;
    rdfs:domain :Lieu ;
    rdfs:range :Departement ;
    rdfs:label "dans département"@fr .

###  dansCommune
:dansCommune rdf:type owl:ObjectProperty ;
    rdfs:domain :Lieu ;
    rdfs:range :Commune ;
    rdfs:label "dans commune"@fr .

###  conduisait
:conduisait rdf:type owl:ObjectProperty ;
    rdfs:domain :Usager ;
    rdfs:range :Vehicule ;
    rdfs:label "conduisait"@fr .

###  passagerDe
:passagerDe rdf:type owl:ObjectProperty ;
    rdfs:domain :Usager ;
    rdfs:range :Vehicule ;
    rdfs:label "passager de"@fr .

###  aConditionLuminosite
:aConditionLuminosite rdf:type owl:ObjectProperty ;
    rdfs:domain :Accident ;
    rdfs:range :ConditionLuminosite ;
    rdfs:label "a condition luminosité"@fr .

###  aConditionAtmospherique
:aConditionAtmospherique rdf:type owl:ObjectProperty ;
    rdfs:domain :Accident ;
    rdfs:range :ConditionAtmospherique ;
    rdfs:label "a condition atmosphérique"@fr .

###  aTypeCollision
:aTypeCollision rdf:type owl:ObjectProperty ;
    rdfs:domain :Accident ;
    rdfs:range :TypeCollision ;
    rdfs:label "a type collision"@fr .

###  aTypeIntersection
:aTypeIntersection rdf:type owl:ObjectProperty ;
    rdfs:domain :Accident ;
    rdfs:range :TypeIntersection ;
    rdfs:label "a type intersection"@fr .

###  aCategorieRoute
:aCategorieRoute rdf:type owl:ObjectProperty ;
    rdfs:domain :Lieu ;
    rdfs:range :CategorieRoute ;
    rdfs:label "a catégorie route"@fr .

###  aTypeCirculation
:aTypeCirculation rdf:type owl:ObjectProperty ;
    rdfs:domain :Lieu ;
    rdfs:range :TypeCirculation ;
    rdfs:label "a type circulation"@fr .

###  aInfrastructure
:aInfrastructure rdf:type owl:ObjectProperty ;
    rdfs:domain :Lieu ;
    rdfs:range :Infrastructure ;
    rdfs:label "a infrastructure"@fr .

###  aEtatSurface
:aEtatSurface rdf:type owl:ObjectProperty ;
    rdfs:domain :Lieu ;
    rdfs:range :EtatSurface ;
    rdfs:label "a état surface"@fr .

###  aCategorieVehicule
:aCategorieVehicule rdf:type owl:ObjectProperty ;
    rdfs:domain :Vehicule ;
    rdfs:range :CategorieVehicule ;
    rdfs:label "a catégorie véhicule"@fr .

###  aGravite
:aGravite rdf:type owl:ObjectProperty ;
    rdfs:domain :Usager ;
    rdfs:range :Gravite ;
    rdfs:label "a gravité"@fr .

###  aCategorieUsager
:aCategorieUsager rdf:type owl:ObjectProperty ;
    rdfs:domain :Usager ;
    rdfs:range :CategorieUsager ;
    rdfs:label "a catégorie usager"@fr .

###  aTypeTrajet
:aTypeTrajet rdf:type owl:ObjectProperty ;
    rdfs:domain :Usager ;
    rdfs:range :TypeTrajet ;
    rdfs:label "a type trajet"@fr .

#################################################################
#    Data Properties - Propriétés des entités
#################################################################

###  Propriétés de l'Accident
:numeroAccident rdf:type owl:DatatypeProperty ;
    rdfs:domain :Accident ;
    rdfs:range xsd:string ;
    rdfs:label "numéro accident"@fr .

:dateAccident rdf:type owl:DatatypeProperty ;
    rdfs:domain :Accident ;
    rdfs:range xsd:date ;
    rdfs:label "date accident"@fr .

:heureAccident rdf:type owl:DatatypeProperty ;
    rdfs:domain :Accident ;
    rdfs:range xsd:time ;
    rdfs:label "heure accident"@fr .

:jour rdf:type owl:DatatypeProperty ;
    rdfs:domain :Accident ;
    rdfs:range xsd:integer ;
    rdfs:label "jour"@fr .

:mois rdf:type owl:DatatypeProperty ;
    rdfs:domain :Accident ;
    rdfs:range xsd:integer ;
    rdfs:label "mois"@fr .

:annee rdf:type owl:DatatypeProperty ;
    rdfs:domain :Accident ;
    rdfs:range xsd:integer ;
    rdfs:label "année"@fr .

:enAgglomeration rdf:type owl:DatatypeProperty ;
    rdfs:domain :Accident ;
    rdfs:range xsd:boolean ;
    rdfs:label "en agglomération"@fr .

###  Propriétés du Lieu
:adresse rdf:type owl:DatatypeProperty ;
    rdfs:domain :Lieu ;
    rdfs:range xsd:string ;
    rdfs:label "adresse"@fr .

:nomVoie rdf:type owl:DatatypeProperty ;
    rdfs:domain :Lieu ;
    rdfs:range xsd:string ;
    rdfs:label "nom voie"@fr .

:latitude rdf:type owl:DatatypeProperty ;
    rdfs:domain :Lieu ;
    rdfs:range xsd:decimal ;
    rdfs:label "latitude"@fr ;
    rdfs:subPropertyOf geo:lat .

:longitude rdf:type owl:DatatypeProperty ;
    rdfs:domain :Lieu ;
    rdfs:range xsd:decimal ;
    rdfs:label "longitude"@fr ;
    rdfs:subPropertyOf geo:long .

:nombreVoies rdf:type owl:DatatypeProperty ;
    rdfs:domain :Lieu ;
    rdfs:range xsd:integer ;
    rdfs:label "nombre de voies"@fr .

:largeurRoute rdf:type owl:DatatypeProperty ;
    rdfs:domain :Lieu ;
    rdfs:range xsd:decimal ;
    rdfs:label "largeur route"@fr .

:vitesseMaxAutorisee rdf:type owl:DatatypeProperty ;
    rdfs:domain :Lieu ;
    rdfs:range xsd:integer ;
    rdfs:label "vitesse max autorisée"@fr .

###  Propriétés de l'Usager
:identifiantUsager rdf:type owl:DatatypeProperty ;
    rdfs:domain :Usager ;
    rdfs:range xsd:string ;
    rdfs:label "identifiant usager"@fr .

:sexe rdf:type owl:DatatypeProperty ;
    rdfs:domain :Usager ;
    rdfs:range xsd:string ;
    rdfs:label "sexe"@fr ;
    rdfs:subPropertyOf foaf:gender .

:anneeNaissance rdf:type owl:DatatypeProperty ;
    rdfs:domain :Usager ;
    rdfs:range xsd:integer ;
    rdfs:label "année de naissance"@fr .

:age rdf:type owl:DatatypeProperty ;
    rdfs:domain :Usager ;
    rdfs:range xsd:integer ;
    rdfs:label "âge"@fr .

:placeVehicule rdf:type owl:DatatypeProperty ;
    rdfs:domain :Usager ;
    rdfs:range xsd:string ;
    rdfs:label "place dans véhicule"@fr .

:ceinture rdf:type owl:DatatypeProperty ;
    rdfs:domain :Usager ;
    rdfs:range xsd:boolean ;
    rdfs:label "ceinture"@fr .

###  Propriétés du Véhicule
:identifiantVehicule rdf:type owl:DatatypeProperty ;
    rdfs:domain :Vehicule ;
    rdfs:range xsd:string ;
    rdfs:label "identifiant véhicule"@fr .

:numeroVehicule rdf:type owl:DatatypeProperty ;
    rdfs:domain :Vehicule ;
    rdfs:range xsd:string ;
    rdfs:label "numéro véhicule"@fr .

:sensCirculation rdf:type owl:DatatypeProperty ;
    rdfs:domain :Vehicule ;
    rdfs:range xsd:string ;
    rdfs:label "sens de circulation"@fr .

:pointChoc rdf:type owl:DatatypeProperty ;
    rdfs:domain :Vehicule ;
    rdfs:range xsd:string ;
    rdfs:label "point de choc"@fr .

:manoeuvre rdf:type owl:DatatypeProperty ;
    rdfs:domain :Vehicule ;
    rdfs:range xsd:string ;
    rdfs:label "manoeuvre"@fr .

:obstacle rdf:type owl:DatatypeProperty ;
    rdfs:domain :Vehicule ;
    rdfs:range xsd:string ;
    rdfs:label "obstacle"@fr .

:obstacleMobile rdf:type owl:DatatypeProperty ;
    rdfs:domain :Vehicule ;
    rdfs:range xsd:string ;
    rdfs:label "obstacle mobile"@fr .

###  Propriétés du Département
:codeDepartement rdf:type owl:DatatypeProperty ;
    rdfs:domain :Departement ;
    rdfs:range xsd:string ;
    rdfs:label "code département"@fr .

:nomDepartement rdf:type owl:DatatypeProperty ;
    rdfs:domain :Departement ;
    rdfs:range xsd:string ;
    rdfs:label "nom département"@fr .

###  Propriétés de la Commune
:codeCommune rdf:type owl:DatatypeProperty ;
    rdfs:domain :Commune ;
    rdfs:range xsd:string ;
    rdfs:label "code commune"@fr .

:nomCommune rdf:type owl:DatatypeProperty ;
    rdfs:domain :Commune ;
    rdfs:range xsd:string ;
    rdfs:label "nom commune"@fr .

#################################################################
#    Individus - Instances des classes de référence
#################################################################

###  Conditions de Luminosité
:PleinJour rdf:type owl:NamedIndividual , :ConditionLuminosite ;
    rdfs:label "Plein jour"@fr .

:CrepusculeAube rdf:type owl:NamedIndividual , :ConditionLuminosite ;
    rdfs:label "Crépuscule ou aube"@fr .

###  Gravités
:Indemne rdf:type owl:NamedIndividual , :Gravite ;
    rdfs:label "Indemne"@fr .

:Tue rdf:type owl:NamedIndividual , :Gravite ;
    rdfs:label "Tué"@fr .

###  Catégories Usager
:Conducteur rdf:type owl:NamedIndividual , :CategorieUsager ;
    rdfs:label "Conducteur"@fr .

:Passager rdf:type owl:NamedIndividual , :CategorieUsager ;
    rdfs:label "Passager"@fr .

###  Types de Trajet
:DomicileTravail rdf:type owl:NamedIndividual , :TypeTrajet ;
    rdfs:label "Domicile - travail"@fr .

:DomicileEcole rdf:type owl:NamedIndividual , :TypeTrajet ;
    rdfs:label "Domicile - école"@fr .

###  Catégories de Route
:Autoroute rdf:type owl:NamedIndividual , :CategorieRoute ;
    rdfs:label "Autoroute"@fr .

:RouteNationale rdf:type owl:NamedIndividual , :CategorieRoute ;
    rdfs:label "Route Nationale"@fr .

###  Types de Circulation
:SensUnique rdf:type owl:NamedIndividual , :TypeCirculation ;
    rdfs:label "A sens unique"@fr .

:Bidirectionnelle rdf:type owl:NamedIndividual , :TypeCirculation ;
    rdfs:label "Bidirectionnelle"@fr .

###  États de Surface
:SurfaceNormale rdf:type owl:NamedIndividual , :EtatSurface ;
    rdfs:label "Surface normale"@fr .

:SurfaceMouillee rdf:type owl:NamedIndividual , :EtatSurface ;
    rdfs:label "Surface mouillée"@fr .

###  Catégories de Véhicule
:Bicyclette rdf:type owl:NamedIndividual , :CategorieVehicule ;
    rdfs:label "Bicyclette"@fr .

:Cyclomoteur rdf:type owl:NamedIndividual , :CategorieVehicule ;
    rdfs:label "Cyclomoteur <50cm3"@fr .